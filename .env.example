# --- Core ---------------------------------------------------------------
# Public origin of the site (used for sitemap, canonical URLs, emails, OG tags).
PUBLIC_SITE_URL=http://localhost:4321
# Postgres connection string (docker-compose default shown).
DATABASE_URL=postgres://ledger:ledger@localhost:5432/office_ledger
# Random 32+ char string used by Better Auth to sign sessions. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Base URL Better Auth uses for callbacks (normally same as PUBLIC_SITE_URL).
BETTER_AUTH_URL=http://localhost:4321
# Random string for signing private file URLs and iCal tokens.
FILE_SIGNING_SECRET=
# Shared secret for /api/cron/* routes (platform cron). Send as `Authorization: Bearer <secret>`.
CRON_SECRET=
# Run node-cron jobs inside the server process (true/false).
JOBS_ENABLED=true
# Require email verification before sign-in (true/false). Dev default false.
REQUIRE_EMAIL_VERIFICATION=false

# --- Email ---------------------------------------------------------------
# Leave SMTP_HOST empty to log emails to the console. Mailpit: localhost:1025. Resend: smtp.resend.com:465.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="Office Ledger <no-reply@officeledger.local>"

# --- Rate limiting -------------------------------------------------------
# Leave empty for in-memory limiter. Set both for Upstash Redis REST.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Web Push (optional) -------------------------------------------------
# Generate with: pnpm dlx web-push generate-vapid-keys
PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@officeledger.local

# --- Uploads ------------------------------------------------------------
# Directory outside public/ where uploaded files are stored.
STORAGE_DIR=./storage
# Max upload size in megabytes.
MAX_UPLOAD_MB=10
# Sign-in / sign-up attempts allowed per IP per minute (raise only for automated tests).
RATE_LIMIT_AUTH_PER_MIN=10
