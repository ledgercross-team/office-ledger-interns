# Shared local environment file.
# Copy this file to .env and replace every placeholder before starting the app.
# Never commit .env or put these values inside the Docker image.

NODE_ENV=development
PORT=4000

# Runtime database login, not the database owner.
DATABASE_URL=postgres://hrms_api:change_me_locally@localhost:5432/office_ledger_hrms
FRONTEND_URL=http://localhost:3000

JWT_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

COOKIE_SECURE=false
COOKIE_DOMAIN=
TRUST_PROXY=false

RATE_LIMIT_GLOBAL_PER_MIN=100
RATE_LIMIT_GLOBAL_BLOCK_SECONDS=60
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_AUTH_BLOCK_SECONDS=300

# Development-only seed value. Do not set this in production.
SEED_DEMO_PASSWORD=change_me_locally

# Required: 32 random bytes encoded as 64 hex characters.
MFA_ENCRYPTION_KEY=replace_with_64_hex_characters

HRMS_JOBS_ENABLED=true
MAIL_TRANSPORT=log

# Owner login used only for migrations/seeding, never by the API runtime.
HRMS_MIGRATE_DATABASE_URL=postgres://postgres:change_me_locally@localhost:5432/office_ledger_hrms

# Frontend build-time API URL.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
