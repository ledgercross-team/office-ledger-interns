---
import BaseLayout from "./BaseLayout.astro";
import Logo from "@/components/layout/Logo.astro";
import { CalendarCheck, Inbox, LineChart, ShieldCheck } from "lucide-react";

interface Props {
  title: string;
  heading: string;
  subheading?: string;
  wide?: boolean;
}
const { title, heading, subheading, wide = false } = Astro.props;
const points = [
  { icon: CalendarCheck, text: "Office and remote check-in with late rules from your settings" },
  { icon: Inbox, text: "One inbox for joins, leave, corrections and complaints" },
  { icon: LineChart, text: "Performance index and locked end-of-day reports" },
  { icon: ShieldCheck, text: "Role-based access for owners, managers and employees" },
];
---

<BaseLayout title={title} noindex>
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:start-3 focus:top-3 focus:z-50 focus:rounded-lg focus:bg-surface focus:px-3 focus:py-2">Skip to content</a>
  <div class="grid min-h-dvh lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)]">
    <aside class="hero-surface relative hidden flex-col justify-between border-e border-border p-10 lg:flex">
      <a href="/" aria-label="Office Ledger home"><Logo /></a>
      <div class="max-w-md">
        <p class="eyebrow mb-3">Workspace for growing offices</p>
        <p class="text-3xl font-semibold leading-tight tracking-tight">Attendance, leave and the work that needs a manager, in one calm place.</p>
        <ul class="mt-8 grid gap-4">
          {
            points.map(({ icon: Icon, text }) => (
              <li class="flex items-start gap-3 text-sm text-muted">
                <span class="grid size-8 shrink-0 place-items-center rounded-lg bg-primary-soft text-primary">
                  <Icon className="size-4" aria-hidden="true" />
                </span>
                <span class="pt-1.5">{text}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <p class="text-xs text-muted">© {new Date().getFullYear()} Office Ledger</p>
    </aside>
    <main id="main" class="flex flex-col items-center justify-center px-4 py-10 sm:px-8">
      <a href="/" class="mb-8 lg:hidden" aria-label="Office Ledger home"><Logo /></a>
      <div class:list={["w-full", wide ? "max-w-xl" : "max-w-sm"]}>
        <h1 class="text-2xl font-semibold tracking-tight">{heading}</h1>
        {subheading && <p class="mt-1.5 text-sm text-muted">{subheading}</p>}
        <div class="mt-6"><slot /></div>
      </div>
    </main>
  </div>
</BaseLayout>
