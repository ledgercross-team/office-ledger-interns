---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import Seo from "@/components/seo/Seo.astro";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  transitions?: boolean;
  bodyClass?: string;
}
const { title, description, noindex, jsonLd, transitions = true, bodyClass = "" } = Astro.props;
// Theme preference: "light" | "dark" | "system". Server-rendered when explicit to avoid a flash.
const themeMode = (
  Astro.isPrerendered ? undefined : (Astro.locals.user?.theme ?? Astro.cookies.get("theme")?.value ?? "system")
) as string | undefined;
const ssrTheme = themeMode === "dark" || themeMode === "light" ? themeMode : undefined;
---

<!doctype html>
<html lang="en" dir="ltr" data-theme={ssrTheme} data-theme-mode={themeMode}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <Seo title={title} description={description} noindex={noindex} jsonLd={jsonLd} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <script is:inline src="/theme.js"></script>
    {transitions && <ClientRouter fallback="swap" />}
    <slot name="head" />
  </head>
  <body class:list={["min-h-dvh", bodyClass]}>
    <slot />
  </body>
</html>
