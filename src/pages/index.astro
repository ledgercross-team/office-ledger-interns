  <section class="landing-dark landing-grid landing-cta" aria-labelledby="cta-heading">
    <div class="marketing-container landing-cta-inner">
      <div class="landing-reveal">
        <h2 id="cta-heading">Replace scattered updates with one accountable record.</h2>
        <p>
          Start with attendance and approvals. Bring notices, tasks, issues, and performance into the same
