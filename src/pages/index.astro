---
export const prerender = true;
import { Image } from "astro:assets";
import MarketingLayout from "@/layouts/MarketingLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { FEATURES } from "@/components/marketing/features";
import { ArrowRight, Check, ChevronDown, Lock, MonitorSmartphone, Moon, Sparkles } from "lucide-react";
import dashLight from "@/assets/screens/dashboard-light.png";
import dashDark from "@/assets/screens/dashboard-dark.png";
import inboxShot from "@/assets/screens/inbox.png";
import tasksShot from "@/assets/screens/tasks.png";
import perfShot from "@/assets/screens/performance.png";

const site = Astro.site!;
const faqs = [
  {
    q: "Who is Office Ledger for?",
    a: "Small and mid-sized offices of roughly 5–300 people that want attendance, leave, tasks and daily reporting in one place, without an HR suite's setup cost.",
  },
  {
    q: "How do employees join?",
    a: "Share your workspace invite code. People sign up, enter the code and wait in Pending until an owner or manager approves them. You can also send email invites with a role and department already set.",
  },
  {
    q: "How is lateness decided?",
    a: "From your settings: office start time plus a late threshold. A check-in after that is Late, and you can require manager approval for late or remote check-ins.",
  },
  {
    q: "Can a locked daily report change?",
    a: "No. The report is saved as an immutable snapshot at office end time. Corrections approved later are listed underneath it, so history is never silently rewritten.",
  },
  {
    q: "Is the performance index an HR evaluation?",
    a: "No. It combines attendance penalties you configure with tracked hours versus expected hours. It's a transparent signal for conversations, and employees can see their own score and how it's calculated.",
  },
  {
    q: "Where is our data stored and can we export it?",
    a: "In your own PostgreSQL database, isolated per workspace with row-level security. Owners can export every table as CSV files in one ZIP at any time.",
  },
];
const jsonLd = [
  { "@context": "https://schema.org", "@type": "WebSite", name: "Office Ledger", url: site.href },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Office Ledger",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web, iOS, Android, Windows, macOS",
    description:
      "Attendance, leave, tasks, calendar, complaints, performance and end-of-day reporting for small and mid-sized offices.",
    url: site.href,
    image: new URL("/og-default.png", site).href,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD", description: "Free during early access" },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
const tiers = [
  {
    name: "Starter",
    price: "Free",
    note: "Up to 10 people",
    items: ["Attendance & leave", "Taskboard & calendar", "Daily report"],
    cta: "Start free",
  },
  {
    name: "Team",
    price: "$3",
    note: "per person / month",
    items: ["Everything in Starter", "Performance index", "Email digests & web push", "CSV import & export"],
    cta: "Start a trial",
    featured: true,
  },
  {
    name: "Business",
    price: "Let's talk",
    note: "100+ people or custom needs",
    items: ["Everything in Team", "SSO and custom retention", "Priority support"],
    cta: "Contact us",
  },
];
---

<MarketingLayout
  title="Attendance, leave and tasks for growing offices"
  description="Office Ledger tracks attendance, leave, tasks, meetings, complaints and performance, and locks a daily report at office close. Built for owners, managers and employees."
  jsonLd={jsonLd}
>
  <section class="hero-surface border-b border-border">
    <div class="mx-auto grid max-w-[1200px] gap-12 px-4 pb-16 pt-16 sm:px-6 lg:pt-24">
      <div class="max-w-3xl">
        <p class="mb-4 inline-flex items-center gap-2 rounded-full border border-border bg-surface px-3 py-1 text-xs font-medium text-muted">
          <Sparkles className="size-3.5 text-primary" aria-hidden="true" /> Office Ledger v2: dark mode,
          command palette and live updates
        </p>
        <h1 class="text-4xl font-semibold leading-[1.1] tracking-tight sm:text-6xl">
          Run the office day, from first check-in to the locked report.
        </h1>
        <p class="mt-5 max-w-2xl text-lg text-muted">
          Attendance, leave, tasks, meetings and complaints in one workspace, with one inbox for everything
          that needs a manager and an end-of-day summary that can't be quietly edited.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/auth/sign-up" class={buttonVariants({ size: "lg" })}>
            Create your workspace <ArrowRight className="size-4" aria-hidden="true" />
          </a>
          <a href="/features" class={buttonVariants({ size: "lg", variant: "outline" })}>
            See every feature
          </a>
        </div>
        <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm text-muted">
          <li class="flex items-center gap-1.5">
            <Check className="size-4 text-success" aria-hidden="true" /> Free for up to 10 people
          </li>
          <li class="flex items-center gap-1.5">
            <Check className="size-4 text-success" aria-hidden="true" /> Set up in 3 steps
          </li>
          <li class="flex items-center gap-1.5">
            <Check className="size-4 text-success" aria-hidden="true" /> Export everything, any time
          </li>
        </ul>
      </div>
      <div class="overflow-hidden rounded-2xl border border-border bg-surface shadow-pop">
        <Image
          src={dashLight}
          alt="Office Ledger dashboard showing check-in coverage, attendance trend, operations mix and the daily briefing"
          widths={[640, 1024, 1440]}
          sizes="(min-width: 1200px) 1150px, 100vw"
          class="block w-full dark:hidden"
          loading="eager"
          fetchpriority="high"
        />
        <Image
          src={dashDark}
          alt=""
          widths={[640, 1024, 1440]}
          sizes="(min-width: 1200px) 1150px, 100vw"
          class="hidden w-full dark:block"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[1200px] px-4 py-20 sm:px-6" aria-labelledby="features-h">
    <p class="eyebrow !text-primary">Everything in one workspace</p>
    <h2 id="features-h" class="mt-2 text-3xl font-semibold tracking-tight">
      Twelve screens, one source of truth
    </h2>
    <p class="mt-3 max-w-2xl text-muted">
      Every number comes from the same SQL resolvers, so the dashboard, the performance ranking and the daily
      report always agree.
    </p>
    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {FEATURES.map(({ icon: Icon, title, text }) => (
        <li class="rounded-2xl border border-border bg-surface p-5 shadow-card">
          <span class="grid size-10 place-items-center rounded-xl bg-primary-soft text-primary">
            <Icon className="size-5" aria-hidden="true" />
          </span>
          <h3 class="mt-4 font-semibold">{title}</h3>
          <p class="mt-1 text-sm text-muted">{text}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="border-y border-border bg-surface" aria-labelledby="tour-h">
    <div class="mx-auto grid max-w-[1200px] gap-16 px-4 py-20 sm:px-6">
      <h2 id="tour-h" class="sr-only">
        Product tour
      </h2>
      {[
        {
          img: inboxShot,
          t: "One inbox for every decision",
          d: "Approve joins, leave, late check-ins and corrections in bulk, or triage from the keyboard. Each decision updates the source record and notifies the person who asked.",
          alt: "Inbox with leave, half-day and join request cards",
        },
        {
          img: tasksShot,
          t: "A taskboard people actually update",
          d: "Drag cards between columns, mention teammates and track checklists. Urgent and blocked counts feed the daily briefing.",
          alt: "Kanban taskboard with To do, In progress and Blocked columns",
        },
        {
          img: perfShot,
          t: "A score you can explain",
          d: "Attendance index, productivity index and their average, with the formula one hover away and trends against the previous period.",
          alt: "Performance ranking table with attendance and productivity indexes",
        },
      ].map((s, i) => (
        <div
          class:list={[
            "grid items-center gap-8 lg:grid-cols-2",
            i % 2 === 1 && "lg:[&>div:first-child]:order-2",
          ]}
        >
          <div>
            <h3 class="text-2xl font-semibold tracking-tight">{s.t}</h3>
            <p class="mt-3 text-muted">{s.d}</p>
          </div>
          <Image
            src={s.img}
            alt={s.alt}
            widths={[480, 800, 1200]}
            sizes="(min-width: 1024px) 560px, 100vw"
            class="w-full rounded-2xl border border-border shadow-pop"
            loading="lazy"
          />
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-[1200px] px-4 py-20 sm:px-6">
    <ul class="grid gap-6 sm:grid-cols-3">
      <li class="flex gap-3">
        <Moon className="mt-1 size-5 shrink-0 text-primary" aria-hidden="true" />
        <div>
          <p class="font-semibold">Light, dark or system</p>
          <p class="text-sm text-muted">Every screen in both themes, with WCAG 2.2 AA contrast.</p>
        </div>
      </li>
      <li class="flex gap-3">
        <MonitorSmartphone className="mt-1 size-5 shrink-0 text-primary" aria-hidden="true" />
        <div>
          <p class="font-semibold">Works on any screen</p>
          <p class="text-sm text-muted">
            Installable app with offline shell, push notifications and a phone tab bar.
          </p>
        </div>
      </li>
      <li class="flex gap-3">
        <Lock className="mt-1 size-5 shrink-0 text-primary" aria-hidden="true" />
        <div>
          <p class="font-semibold">Private by design</p>
          <p class="text-sm text-muted">
            Row-level isolation, two-factor sign-in, signed file links and a full audit log.
          </p>
        </div>
      </li>
    </ul>
  </section>

  <section
    id="pricing"
    class="mx-auto max-w-[1200px] scroll-mt-20 px-4 py-12 sm:px-6"
    aria-labelledby="pricing-h"
  >
    <p class="eyebrow !text-primary">Pricing</p>
    <h2 id="pricing-h" class="mt-2 text-3xl font-semibold tracking-tight">
      Simple, per-person pricing
    </h2>
    <p class="mt-2 text-sm text-muted">
      Placeholder pricing during early access. Everything is free while we're in beta.
    </p>
    <ul class="mt-8 grid gap-4 lg:grid-cols-3">
      {tiers.map((t) => (
        <li
          class:list={[
            "flex flex-col rounded-2xl border bg-surface p-6 shadow-card",
            t.featured ? "border-primary ring-1 ring-primary" : "border-border",
          ]}
        >
          <p class="font-semibold">{t.name}</p>
          <p class="mt-3 text-3xl font-semibold tabular">{t.price}</p>
          <p class="text-sm text-muted">{t.note}</p>
          <ul class="mt-5 grid flex-1 gap-2 text-sm">
            {t.items.map((it) => (
              <li class="flex items-center gap-2">
                <Check className="size-4 text-success" aria-hidden="true" /> {it}
              </li>
            ))}
          </ul>
          <a
            href={t.name === "Business" ? "/contact" : "/auth/sign-up"}
            class={buttonVariants({ variant: t.featured ? "primary" : "outline" }) + " mt-6"}
          >
            {t.cta}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-20 sm:px-6" aria-labelledby="faq-h">
    <h2 id="faq-h" class="text-3xl font-semibold tracking-tight">
      Frequently asked questions
    </h2>
    <div class="mt-8 divide-y divide-border rounded-2xl border border-border bg-surface">
      {faqs.map((f) => (
        <details class="group px-5 py-4 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium">
            {f.q}
            <ChevronDown
              className="size-4 shrink-0 text-muted transition-transform group-open:rotate-180"
              aria-hidden="true"
            />
          </summary>
          <p class="mt-2 text-sm text-muted">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-[1200px] px-4 sm:px-6">
    <div class="hero-surface rounded-3xl border border-border px-6 py-14 text-center">
      <h2 class="text-3xl font-semibold tracking-tight">Set up your office in five minutes</h2>
      <p class="mx-auto mt-3 max-w-xl text-muted">
        Name your workspace, set office hours and weekends, add departments, then share the invite code.
      </p>
      <a href="/auth/sign-up" class={buttonVariants({ size: "lg" }) + " mt-8"}>
        Create your workspace <ArrowRight className="size-4" aria-hidden="true" />
      </a>
    </div>
  </section>
</MarketingLayout>
