              </span>
            </div>
            <div class="workflow-panel-header">
              <span>Headquarters</span>
              <small>4th Avenue, Floor 6</small>
            </div>
            <div class="workflow-panel-body">
              <div class="workflow-panel-row">
                <span>Office hours 9:00 to 18:00</span>
                <span class="switch"></span>
              </div>
