            </div>
            <div class="preview-panel" data-mode-panel="employee">
              <div class="preview-panel-title">
                <span>My workday</span>
                <em>Today</em>
              </div>
              <div class="preview-list">
                <div class="preview-list-row">
                  <span class="preview-avatar">✓</span>
                  <span>Checked in · Office</span>
                  <span class="status">Present</span>
                </div>
                <div class="preview-list-row">
                  <span class="preview-avatar">2</span>
                  <span>Tasks completed</span>
                  <span class="preview-meta">of 3</span>
                </div>
                <div class="preview-list-row">
                  <span class="preview-avatar">→</span>
