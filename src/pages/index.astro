<script>
  document.documentElement.classList.add("has-js");

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const revealNodes = document.querySelectorAll<HTMLElement>(".landing-reveal:not(.is-visible)");
  if (reduceMotion) {
    revealNodes.forEach((node) => node.classList.add("is-visible"));
  } else if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) =>
        entries.forEach((entry) => entry.isIntersecting && entry.target.classList.add("is-visible")),
      { threshold: 0.14, rootMargin: "0px 0px -7%" },
    );
    revealNodes.forEach((node) => observer.observe(node));
  } else {
    revealNodes.forEach((node) => node.classList.add("is-visible"));
  }

  const heroPreview = document.querySelector<HTMLElement>("[data-hero-preview]");
  heroPreview?.querySelectorAll<HTMLButtonElement>("[data-preview-mode]").forEach((button) => {
    button.addEventListener("click", () => {
      const mode = button.dataset.previewMode ?? "manager";
      heroPreview.dataset.mode = mode;
      heroPreview.querySelectorAll<HTMLButtonElement>("[data-preview-mode]").forEach((item) => {
        const active = item === button;
        item.classList.toggle("is-active", active);
        item.setAttribute("aria-pressed", String(active));
      });
    });
  });

  const workflow = document.querySelector<HTMLElement>("[data-workflow]");
  let workflowTicking = false;
  const updateWorkflow = () => {
    if (!workflow) return;
    const travel = workflow.offsetHeight - window.innerHeight;
    const progress =
      travel > 0 ? Math.min(1, Math.max(0, -workflow.getBoundingClientRect().top / travel)) : 0;
    workflow.dataset.active = String(Math.min(2, Math.floor(progress * 3)));
    workflowTicking = false;
  };
  if (workflow) {
    window.addEventListener(
      "scroll",
      () => {
        if (!workflowTicking) {
          window.requestAnimationFrame(updateWorkflow);
          workflowTicking = true;
        }
      },
      { passive: true },
    );
    updateWorkflow();
  }
</script>
