---
export const prerender = true;
import MarketingLayout from "@/layouts/MarketingLayout.astro";
import "@/styles/landing.css";
import {
  ArrowRight,
  Bell,
  Building2,
  CalendarDays,
  ClipboardList,
  FileText,
  ListChecks,
  MapPin,
  ShieldCheck,
  Sparkles,
} from "lucide-react";

const site = Astro.site!;
const faqs = [
  {
    q: "Who is Office Ledger for?",
    a: "Small and mid-sized offices that want attendance, leave, tasks and daily reporting in one accountable workspace.",
  },
  {
    q: "How do employees join?",
    a: "Share a workspace invite code. Employees sign up, enter the code and wait for an owner or manager to approve them.",
  },
  {
    q: "Can a daily report change after it is locked?",
    a: "The original report remains immutable. Approved corrections are recorded underneath it so history is never silently rewritten.",
  },
];
const jsonLd = [
  { "@context": "https://schema.org", "@type": "WebSite", name: "Office Ledger", url: site.href },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Office Ledger",
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web, iOS, Android, Windows, macOS",
    description: "One accountable record for attendance, approvals, tasks, meetings and office performance.",
    url: site.href,
    image: new URL("/og-default.png", site).href,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD", description: "Free during early access" },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<MarketingLayout
  title="Clarity, codified. | Office Ledger"
  description="Attendance, approvals, tasks, meetings and office performance in one accountable record."
  jsonLd={jsonLd}
>
  <section class="landing-dark landing-grid landing-hero">
    <div class="marketing-container landing-hero-inner">
      <div class="landing-reveal is-visible">
        <p class="landing-eyebrow">
          <span class="landing-eyebrow-dot"></span>Daily operations, one record
        </p>
        <h1>Clarity, codified.</h1>
        <p class="landing-hero-copy">
          Attendance, approvals, tasks, and notices in one record. Managers see what needs a decision today.
          Employees see exactly where they stand.
        </p>
        <div class="landing-hero-actions">
          <a href="/auth/sign-up" class="marketing-button">
            Start your office ledger <ArrowRight size={15} aria-hidden="true" />
          </a>
          <a href="/demo" class="marketing-button marketing-button-ghost">
            Try the demo
          </a>
        </div>
        <div class="landing-proof-nav" aria-label="Product areas">
          <span>Attendance</span>
          <span>Approvals</span>
          <span>Tasks</span>
          <span>Notices</span>
          <span>Performance</span>
        </div>
      </div>

      <div class="hero-preview-wrap landing-reveal" data-delay="1">
        <div class="hero-preview" data-hero-preview data-mode="manager">
          <div class="preview-topbar">
            <div class="preview-topbar-left">
              <span class="preview-orb" aria-hidden="true"></span>
              <span class="preview-brand">Office Ledger</span>
            </div>
            <div class="preview-topbar-right">
              <div class="preview-mode" role="group" aria-label="Preview role">
                <button type="button" class="is-active" data-preview-mode="manager" aria-pressed="true">
                  Manager
                </button>
                <button type="button" data-preview-mode="employee" aria-pressed="false">
                  Employee
                </button>
              </div>
              <span class="preview-live">
                <span class="live-dot"></span> LIVE
              </span>
            </div>
          </div>
          <div class="preview-body">
            <div class="preview-stat-grid">
              <div class="preview-stat">
                <strong>45</strong>
                <span>Present</span>
              </div>
              <div class="preview-stat">
                <strong>12</strong>
                <span>Remote</span>
              </div>
              <div class="preview-stat">
                <strong>3</strong>
                <span>Late</span>
              </div>
              <div class="preview-stat">
                <strong>5</strong>
                <span>On leave</span>
              </div>
            </div>
            <div class="preview-panel" data-mode-panel="manager">
              <div class="preview-panel-title">
                <span>Today's attendance</span>
                <em>58 in workspace</em>
              </div>
              <div class="preview-list">
                <div class="preview-list-row">
                  <span class="preview-avatar">AT</span>
                  <span>Ava Thompson</span>
                  <span class="preview-meta">9:02</span>
                  <span class="status">Present</span>
                </div>
                <div class="preview-list-row">
                  <span class="preview-avatar">MR</span>
                  <span>Marcus Reed</span>
                  <span class="preview-meta">9:11</span>
                  <span class="status remote">Remote</span>
                </div>
                <div class="preview-list-row">
                  <span class="preview-avatar">LO</span>
                  <span>Lena Ortiz</span>
                  <span class="preview-meta">9:34</span>
