                <div class="mock-row">
                  <span class="preview-avatar">✓</span>
                  <span>
                    <strong>Review onboarding doc</strong>
                    <small>Completed</small>
                  </span>
                </div>
                <div class="mock-row">
                  <span class="preview-avatar">○</span>
                  <span>
                    <strong>Prep standup notes</strong>
                    <small>Due today</small>
                  </span>
                </div>
              </div>
            </div>
            <div class="workday-card">
              <div class="mock-heading">
                <span>Leave request · June 12</span>
                <small>Under review</small>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="landing-light landing-section bento-section" aria-labelledby="moving-heading">
    <div class="marketing-container">
      <div class="landing-section-head landing-reveal">
        <p class="landing-kicker">
          <Sparkles size={14} aria-hidden="true" />
