---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Logo from "@/components/layout/Logo.astro";
import { buttonVariants } from "@/components/ui/button";
import { Compass } from "lucide-react";
---

<BaseLayout title="Page not found" noindex>
  <main id="main" class="hero-surface grid min-h-dvh place-items-center px-4">
    <div class="max-w-md text-center">
      <a href="/" class="inline-block" aria-label="Office Ledger home">
        <Logo />
      </a>
      <span class="mx-auto mt-10 grid size-14 place-items-center rounded-2xl bg-primary-soft text-primary">
        <Compass className="size-7" aria-hidden="true" />
      </span>
      <p class="eyebrow mt-6">Error 404</p>
      <h1 class="mt-1 text-2xl font-semibold">We couldn't find that page</h1>
      <p class="mt-2 text-sm text-muted">The link may be old, or the page may have moved.</p>
      <div class="mt-6 flex justify-center gap-2">
        <a href="/app" class={buttonVariants()}>
          Go to dashboard
        </a>
        <a href="/" class={buttonVariants({ variant: "outline" })}>
          Home
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
