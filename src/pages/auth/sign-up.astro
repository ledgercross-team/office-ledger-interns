---
import AuthLayout from "@/layouts/AuthLayout.astro";
import { SignUpForm } from "@/components/features/auth/forms";
import { env } from "@/lib/env";
const next = Astro.url.searchParams.get("next");
const email = Astro.url.searchParams.get("email") ?? "";
---

<AuthLayout title="Create account" heading="Create your account" subheading="Then join your team with an invite code, or set up a new workspace.">
  <SignUpForm client:load next={next} requireVerification={env.REQUIRE_EMAIL_VERIFICATION} initialEmail={email} />
</AuthLayout>
