---
import { eq } from "drizzle-orm";
import AuthLayout from "@/layouts/AuthLayout.astro";
import { AcceptInvite } from "@/components/features/auth/forms";
import { buttonVariants } from "@/components/ui/button";
import { db } from "@/db";
import { invites, workspaces } from "@/db/schema";
const { token } = Astro.params;
const [row] = token
  ? await db
      .select({ inv: invites, ws: { name: workspaces.name } })
      .from(invites)
      .innerJoin(workspaces, eq(workspaces.id, invites.workspaceId))
      .where(eq(invites.token, token))
  : [];
const valid = row && !row.inv.acceptedAt && row.inv.expiresAt > new Date();
const user = Astro.locals.user;
const next = `/auth/invite/${token}`;
---

<AuthLayout
  title="Workspace invite"
  heading={valid ? `Join ${row!.ws.name}` : "Invite unavailable"}
  subheading={
    valid ? `You've been invited as ${row!.inv.role}.` : "This invite link is invalid, used, or expired."
  }
>
  {valid && user ? (
    <AcceptInvite client:load token={token!} />
  ) : valid ? (
    <div class="grid gap-2">
      <a
        href={`/auth/sign-up?next=${encodeURIComponent(next)}&email=${encodeURIComponent(row!.inv.email)}`}
        class={buttonVariants({ size: "lg" })}
      >
        Create account
      </a>
      <a
        href={`/auth/sign-in?next=${encodeURIComponent(next)}`}
        class={buttonVariants({ variant: "outline", size: "lg" })}
      >
        I already have an account
      </a>
    </div>
  ) : (
    <a href="/auth/sign-in" class={buttonVariants({ variant: "outline" })}>
      Go to sign in
    </a>
  )}
</AuthLayout>
