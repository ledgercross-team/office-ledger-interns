---
import AuthLayout from "@/layouts/AuthLayout.astro";
import { JoinForm, SignOutButton } from "@/components/features/auth/forms";
import { Building2 } from "lucide-react";
const { user, ctx } = Astro.locals;
if (!user) return Astro.redirect("/auth/sign-in?next=/auth/join");
if (ctx?.status === "active") return Astro.redirect("/app");
const revoked = ctx?.status === "rejected" || ctx?.status === "deactivated";
---

<AuthLayout title="Join a workspace" heading="Join your team" subheading={`Signed in as ${user.email}`}>
  {
    revoked && (
      <p role="alert" class="mb-4 rounded-xl bg-warning-soft px-3 py-2 text-sm text-warning-text">
        Your access to {ctx?.workspaceName} is no longer active. Join another workspace or contact its owner.
      </p>
    )
  }
  <JoinForm client:load />
  <div class="my-6 flex items-center gap-3 text-xs text-muted"><span class="h-px flex-1 bg-border"></span>or<span class="h-px flex-1 bg-border"></span></div>
  <a href="/auth/setup" class="flex items-center gap-3 rounded-2xl border border-border bg-surface p-4 transition-colors hover:bg-surface-2">
    <span class="grid size-10 place-items-center rounded-xl bg-primary-soft text-primary"><Building2 className="size-5" aria-hidden="true" /></span>
    <span><span class="block font-medium">Create a new workspace</span><span class="text-sm text-muted">You'll be the organization owner.</span></span>
  </a>
  <div class="mt-6 text-center"><SignOutButton client:load variant="link" /></div>
</AuthLayout>
