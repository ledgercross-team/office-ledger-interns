---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Logo from "@/components/layout/Logo.astro";
import { buttonVariants } from "@/components/ui/button";
import { ServerCrash } from "lucide-react";
---

<BaseLayout title="Something went wrong" noindex>
  <main id="main" class="hero-surface grid min-h-dvh place-items-center px-4">
    <div class="max-w-md text-center">
      <a href="/" class="inline-block" aria-label="Office Ledger home">
        <Logo />
      </a>
      <span class="mx-auto mt-10 grid size-14 place-items-center rounded-2xl bg-danger-soft text-danger-text">
        <ServerCrash className="size-7" aria-hidden="true" />
      </span>
      <p class="eyebrow mt-6">Error 500</p>
      <h1 class="mt-1 text-2xl font-semibold">Something went wrong on our side</h1>
      <p class="mt-2 text-sm text-muted">
        Nothing you did caused this. Try again in a moment; if it keeps happening, contact your workspace
        owner.
      </p>
      <div class="mt-6 flex justify-center gap-2">
        <a href="/app" class={buttonVariants()}>
          Try again
        </a>
        <a href="/" class={buttonVariants({ variant: "outline" })}>
          Home
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
