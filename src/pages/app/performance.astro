---
import AppLayout from "@/layouts/AppLayout.astro";
import PageHero from "@/components/layout/PageHero.astro";
import RefreshButton from "@/components/layout/RefreshButton";
import PerformancePage from "@/components/features/reports/PerformancePage";
import { withWorkspace } from "@/db";
import { performance } from "@/lib/queries/reports";
import { localDate } from "@/lib/dates";
import { can } from "@/lib/permissions";
import { t } from "@/i18n/en";

const ctx = Astro.locals.ctx!;
const today = localDate(ctx.timezone);
const defaults = { start: `${today.slice(0, 7)}-01`, end: today };
const q = Astro.url.searchParams;
const isDate = (v: string | null): v is string => !!v && /^\d{4}-\d{2}-\d{2}$/.test(v);
const start = isDate(q.get("start")) ? q.get("start")! : defaults.start;
const end = isDate(q.get("end")) && q.get("end")! >= start ? q.get("end")! : defaults.end;
const data = await withWorkspace(ctx.workspaceId, (tx) => performance(tx, ctx, start, end));
---

<AppLayout title="Performance">
  <PageHero
    title={can(ctx, "performance.viewAll") ? t("pages.performance.title") : "Your performance"}
    description={t("pages.performance.description")}
  >
    <RefreshButton slot="actions" client:idle />
  </PageHero>
  <PerformancePage client:load initial={data} defaults={defaults} />
</AppLayout>
