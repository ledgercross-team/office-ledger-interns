---
import AppLayout from "@/layouts/AppLayout.astro";
import PageHero from "@/components/layout/PageHero.astro";
import RefreshButton from "@/components/layout/RefreshButton";
import AttendancePage from "@/components/features/attendance/AttendancePage";
import { withWorkspace } from "@/db";
import { attendanceToday, notCheckedIn } from "@/lib/queries/attendance";
import { fmtDate } from "@/lib/dates";
import { t } from "@/i18n/en";

const ctx = Astro.locals.ctx!;
const data = await withWorkspace(ctx.workspaceId, async (tx) => ({
  ...(await attendanceToday(tx, ctx)),
  missing: ctx.role === "employee" ? [] : await notCheckedIn(tx, ctx),
}));
const dateLabel = fmtDate(data.today, ctx.locale, { weekday: "long", month: "short", day: "numeric", year: undefined });
---

<AppLayout title="Attendance">
  <PageHero title={t("pages.attendance.title")} description={t("pages.attendance.description", { date: dateLabel })}>
    <RefreshButton slot="actions" client:idle />
  </PageHero>
  <AttendancePage client:load initial={data} />
</AppLayout>
