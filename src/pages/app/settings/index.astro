---
import AppLayout from "@/layouts/AppLayout.astro";
import PageHero from "@/components/layout/PageHero.astro";
import RefreshButton from "@/components/layout/RefreshButton";
import SettingsPage from "@/components/features/settings/SettingsPage";
import { withWorkspace } from "@/db";
import { settingsPage } from "@/actions/settings";
import { t } from "@/i18n/en";

const ctx = Astro.locals.ctx!;
const data = await withWorkspace(ctx.workspaceId, (tx) => settingsPage(tx, ctx));
const tab = Astro.url.searchParams.get("tab") ?? undefined;
---

<AppLayout title="Settings">
  <PageHero title={t("pages.settings.title")} description={t("pages.settings.description")}>
    <RefreshButton slot="actions" client:idle />
  </PageHero>
  <SettingsPage client:load initial={data} initialTab={tab} />
</AppLayout>
