---
import AppLayout from "@/layouts/AppLayout.astro";
import PageHero from "@/components/layout/PageHero.astro";
import AuditPage from "@/components/features/settings/AuditPage";
import { buttonVariants } from "@/components/ui/button";
import { withWorkspace } from "@/db";
import { auditList } from "@/actions/settings";
import { addDaysISO, localDate } from "@/lib/dates";
import { t } from "@/i18n/en";
import { ArrowLeft } from "lucide-react";

const ctx = Astro.locals.ctx!;
const to = localDate(ctx.timezone);
const range = { from: addDaysISO(to, -30), to };
const rows = await withWorkspace(ctx.workspaceId, (tx) => auditList(tx, range.from, range.to));
---

<AppLayout title="Audit log">
  <a href="/app/settings" class={buttonVariants({ variant: "ghost", size: "sm" }) + " mb-3 -ms-2"}>
    <ArrowLeft className="rtl:rotate-180" aria-hidden="true" /> Settings
  </a>
  <PageHero title={t("pages.audit.title")} description={t("pages.audit.description")} />
  <AuditPage client:load initial={rows} range={range} tz={ctx.timezone} />
</AppLayout>
