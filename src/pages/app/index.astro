---
import AppLayout from "@/layouts/AppLayout.astro";
import PageHero from "@/components/layout/PageHero.astro";
import RefreshButton from "@/components/layout/RefreshButton";
const { ctx } = Astro.locals;
---

<AppLayout title="Dashboard">
  <PageHero title={`${ctx!.workspaceName} operations`} description="Today's attendance and the workload that needs a manager">
    <RefreshButton slot="actions" client:idle />
  </PageHero>
</AppLayout>
