---
import AppLayout from "@/layouts/AppLayout.astro";
import PageHero from "@/components/layout/PageHero.astro";
import DashboardPage from "@/components/features/dashboard/DashboardPage";
import { buttonVariants } from "@/components/ui/button";
import { withWorkspace } from "@/db";
import { dashboard } from "@/lib/queries/reports";
import { can } from "@/lib/permissions";
import { t } from "@/i18n/en";
import { FileText } from "lucide-react";

const ctx = Astro.locals.ctx!;
const user = Astro.locals.user!;
const data = await withWorkspace(ctx.workspaceId, (tx) => dashboard(tx, ctx));
const org = can(ctx, "dashboard.org");
---

<AppLayout title="Dashboard">
  <PageHero
    title={
      org
        ? t("pages.dashboard.title", { workspace: ctx.workspaceName })
        : t("pages.dashboard.employeeTitle", { name: user.name.split(" ")[0] ?? user.name })
    }
    description={org ? t("pages.dashboard.description") : t("pages.dashboard.employeeDescription")}
  >
    {can(ctx, "report.view") && (
      <a href="/app/reports/daily" class={buttonVariants({ variant: "outline" })} slot="actions">
        <FileText aria-hidden="true" /> {t("pages.dashboard.brief")}
      </a>
    )}
  </PageHero>
  <DashboardPage client:load initial={data} workspace={ctx.workspaceName} />
</AppLayout>
