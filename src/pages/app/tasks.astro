---
import AppLayout from "@/layouts/AppLayout.astro";
import PageHero from "@/components/layout/PageHero.astro";
import TaskboardPage from "@/components/features/tasks/TaskboardPage";
import NewTaskButton from "@/components/features/tasks/NewTaskButton";
import { withWorkspace } from "@/db";
import { taskBoard } from "@/lib/queries/tasks";
import { t } from "@/i18n/en";

const ctx = Astro.locals.ctx!;
const data = await withWorkspace(ctx.workspaceId, (tx) => taskBoard(tx, ctx));
const taskParam = Astro.url.searchParams.get("task");
const task = taskParam && /^[0-9a-f-]{36}$/.test(taskParam) ? taskParam : null;
---

<AppLayout title="Taskboard">
  <PageHero title={t("pages.tasks.title")} description={t("pages.tasks.description")}>
    <NewTaskButton slot="actions" client:idle />
  </PageHero>
  <TaskboardPage client:load initial={data} openTask={task} openNew={Astro.url.searchParams.has("new")} />
</AppLayout>
