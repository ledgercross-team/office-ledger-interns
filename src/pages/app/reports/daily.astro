---
import AppLayout from "@/layouts/AppLayout.astro";
import PageHero from "@/components/layout/PageHero.astro";
import RefreshButton from "@/components/layout/RefreshButton";
import DailyReportPage from "@/components/features/reports/DailyReportPage";
import { withWorkspace } from "@/db";
import { dailyReport } from "@/lib/queries/reports";
import { localDate } from "@/lib/dates";
import { t } from "@/i18n/en";

const ctx = Astro.locals.ctx!;
const today = localDate(ctx.timezone);
const param = Astro.url.searchParams.get("date");
const date = param && /^\d{4}-\d{2}-\d{2}$/.test(param) && param <= today ? param : today;
const data = await withWorkspace(ctx.workspaceId, (tx) => dailyReport(tx, ctx, date));
---

<AppLayout title="Daily Report">
  <PageHero
    eyebrow={t("pages.dailyReport.eyebrow")}
    title={t("pages.dailyReport.title")}
    description={t("pages.dailyReport.description")}
  >
    <RefreshButton slot="actions" client:idle />
  </PageHero>
  <DailyReportPage client:load initial={data} workspace={ctx.workspaceName} />
</AppLayout>
