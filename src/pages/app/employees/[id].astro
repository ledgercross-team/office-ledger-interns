---
import AppLayout from "@/layouts/AppLayout.astro";
import ProfileView from "@/components/features/employees/ProfileView.astro";
import { Button } from "@/components/ui/button";
import { ArrowLeft } from "lucide-react";

const { id } = Astro.params;
if (!id || !/^[0-9a-f-]{36}$/.test(id)) return Astro.rewrite("/404");
if (id === Astro.locals.ctx!.membershipId) return Astro.redirect("/app/me");
---

<AppLayout title="Employee profile">
  <Button asChild variant="ghost" size="sm" className="mb-3 -ms-2">
    <a href="/app/employees"><ArrowLeft className="rtl:rotate-180" aria-hidden="true" /> All employees</a>
  </Button>
  <ProfileView membershipId={id} />
</AppLayout>
