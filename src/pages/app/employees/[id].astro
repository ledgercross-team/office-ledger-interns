---
import AppLayout from "@/layouts/AppLayout.astro";
import ProfileView from "@/components/features/employees/ProfileView.astro";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/cn";
import { ArrowLeft } from "lucide-react";

const { id } = Astro.params;
if (!id || !/^[0-9a-f-]{36}$/.test(id)) return Astro.rewrite("/404");
if (id === Astro.locals.ctx!.membershipId) return Astro.redirect("/app/me");
---

<AppLayout title="Employee profile">
  <a href="/app/employees" class={cn(buttonVariants({ variant: "ghost", size: "sm" }), "mb-3 -ms-2")}>
    <ArrowLeft className="rtl:rotate-180" aria-hidden="true" /> All employees
  </a>
  <ProfileView membershipId={id} />
</AppLayout>
