---
import AppLayout from "@/layouts/AppLayout.astro";
import PageHero from "@/components/layout/PageHero.astro";
import RefreshButton from "@/components/layout/RefreshButton";
import LeavePage from "@/components/features/leave/LeavePage";
import { withWorkspace } from "@/db";
import { leavePage } from "@/lib/queries/leave";
import { t } from "@/i18n/en";

const ctx = Astro.locals.ctx!;
const data = await withWorkspace(ctx.workspaceId, (tx) => leavePage(tx, ctx));
const reviewer = data.mode === "reviewer";
---

<AppLayout title="Leave Requests">
  <PageHero
    title={reviewer ? t("pages.leave.title") : t("pages.leave.employeeTitle")}
    description={reviewer ? t("pages.leave.description") : t("pages.leave.employeeDescription")}
  >
    <RefreshButton slot="actions" client:idle />
  </PageHero>
  <LeavePage client:load initial={data} openNew={Astro.url.searchParams.has("new")} />
</AppLayout>
