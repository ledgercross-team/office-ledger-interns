---
import AppLayout from "@/layouts/AppLayout.astro";
import PageHero from "@/components/layout/PageHero.astro";
import RefreshButton from "@/components/layout/RefreshButton";
import CalendarPage from "@/components/features/calendar/CalendarPage";
import { withWorkspace } from "@/db";
import { calendarPage } from "@/lib/queries/calendar";
import { localDate } from "@/lib/dates";
import { t } from "@/i18n/en";

const ctx = Astro.locals.ctx!;
const params = Astro.url.searchParams;
const dateParam = params.get("date");
const date = dateParam && /^\d{4}-\d{2}-\d{2}$/.test(dateParam) ? dateParam : null;
const month = (date ?? localDate(ctx.timezone)).slice(0, 7);
const data = await withWorkspace(ctx.workspaceId, (tx) => calendarPage(tx, ctx, month));
const tabParam = params.get("tab");
const tab = tabParam === "leave" || tabParam === "holidays" ? tabParam : "meetings";
const meetingParam = params.get("meeting");
const meeting = meetingParam && /^[0-9a-f-]{36}$/.test(meetingParam) ? meetingParam : null;
---

<AppLayout title="Calendar">
  <PageHero title={t("pages.calendar.title")} description={t("pages.calendar.description")}>
    <RefreshButton slot="actions" client:idle />
  </PageHero>
  <CalendarPage client:load initial={data} initialTab={tab} openMeeting={meeting} initialDate={date} />
</AppLayout>
