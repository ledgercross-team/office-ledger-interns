---
export const prerender = true;
import MarketingLayout from "@/layouts/MarketingLayout.astro";
import { FEATURES } from "@/components/marketing/features";
import { buttonVariants } from "@/components/ui/button";
import { Check } from "lucide-react";
const roles = [
  {
    role: "Owner",
    text: "Configures office hours, policies and scoring, approves holidays, manages roles, and sees everything, including the audit log.",
  },
  {
    role: "Manager",
    text: "Approves joins, leave and attendance for employees, runs the taskboard and calendar, and reads the daily report and performance ranking.",
  },
  {
    role: "Employee",
    text: "Checks in, requests leave, works on assigned tasks, RSVPs to meetings, raises issues and sees their own score.",
  },
];
---

<MarketingLayout
  title="Features"
  description="Every Office Ledger screen: dashboard, inbox, attendance, leave, taskboard, calendar, performance, daily report, employees, complaints and settings."
>
  <section class="hero-surface border-b border-border">
    <div class="mx-auto max-w-[1200px] px-4 py-16 sm:px-6">
      <p class="eyebrow !text-primary">Features</p>
      <h1 class="mt-2 max-w-3xl text-4xl font-semibold tracking-tight sm:text-5xl">
        Everything an office needs between check-in and close
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-muted">
        Built around three roles with permissions enforced on the server, not just hidden in the UI.
      </p>
    </div>
  </section>
  <section class="mx-auto max-w-[1200px] px-4 py-16 sm:px-6">
    <ul class="grid gap-6 md:grid-cols-2">
      {FEATURES.map(({ icon: Icon, title, text, points }) => (
        <li class="rounded-2xl border border-border bg-surface p-6 shadow-card">
          <div class="flex items-center gap-3">
            <span class="grid size-10 place-items-center rounded-xl bg-primary-soft text-primary">
              <Icon className="size-5" aria-hidden="true" />
            </span>
            <h2 class="text-lg font-semibold">{title}</h2>
          </div>
          <p class="mt-3 text-muted">{text}</p>
          <ul class="mt-4 grid gap-1.5 text-sm">
            {points.map((p) => (
              <li class="flex items-center gap-2">
                <Check className="size-4 text-success" aria-hidden="true" /> {p}
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ul>
  </section>
  <section class="mx-auto max-w-[1200px] px-4 sm:px-6" aria-labelledby="roles-h">
    <h2 id="roles-h" class="text-2xl font-semibold tracking-tight">
      Built for three roles
    </h2>
    <ul class="mt-6 grid gap-4 md:grid-cols-3">
      {roles.map((r) => (
        <li class="rounded-2xl border border-border p-5">
          <p class="font-semibold">{r.role}</p>
          <p class="mt-1 text-sm text-muted">{r.text}</p>
        </li>
      ))}
    </ul>
    <a href="/auth/sign-up" class={buttonVariants({ size: "lg" }) + " mt-10"}>
      Create your workspace
    </a>
  </section>
</MarketingLayout>
