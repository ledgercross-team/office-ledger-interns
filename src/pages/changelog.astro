---
export const prerender = true;
import MarketingLayout from "@/layouts/MarketingLayout.astro";
import Prose from "@/components/marketing/Prose.astro";
const releases = [
  {
    v: "2.0.0",
    date: "October 2026",
    title: "Office Ledger v2",
    notes: [
      "New design with light, dark and system themes, a collapsible sidebar and a phone tab bar",
      "Command palette (Ctrl/⌘ K) for pages, people, tasks and quick actions",
      "Live updates and notifications, optional browser push and email digests",
      "Inbox: Exceptions tab, keyboard triage, rejection reasons and waiting-time badges",
      "Attendance: breaks, correction requests, auto-checkout and optional office location/IP checks",
      "Leave: configurable types and quotas, balances with accrual, overlap warnings",
      "Taskboard: checklists, comments with @mentions, attachments, list and My tasks views",
      "Calendar: week view, recurring meetings, RSVP, ICS export and a personal iCal feed",
      "Performance: trends against the previous period, CSV/PDF export, employees see their own score",
      "Daily report: weekly and monthly roll-ups, email, plain-text copy and print view",
      "Complaints: anonymous submissions, severity, assignee and status history",
      "Settings: leave, scoring, notifications, members & roles, data export and an audit log",
      "Security: two-factor sign-in, session management, row-level security and signed file links",
    ],
  },
  {
    v: "1.x",
    date: "2025–2026",
    title: "Office Ledger v1",
    notes: [
      "Dashboard, inbox, employees, attendance, leave, taskboard, calendar, performance, daily report, complaints and settings",
    ],
  },
];
---

<MarketingLayout title="Changelog" description="What's new in Office Ledger.">
  <Prose eyebrow="Changelog" title="What's new">
    {releases.map((r) => (
      <section>
        <h2>
          {r.title}{" "}
          <span class="text-sm font-normal text-muted">
            · v{r.v} · {r.date}
          </span>
        </h2>
        <ul>
          {r.notes.map((n) => (
            <li>{n}</li>
          ))}
        </ul>
      </section>
    ))}
  </Prose>
</MarketingLayout>
