---
export const prerender = true;
import MarketingLayout from "@/layouts/MarketingLayout.astro";
import Prose from "@/components/marketing/Prose.astro";
---

<MarketingLayout title="Terms of service" description="The terms for using Office Ledger.">
  <Prose eyebrow="Legal" title="Terms of service" updated="October 5, 2026">
    <h2>Using Office Ledger</h2>
    <p>
      By creating an account you agree to these terms. If you create a workspace, you confirm you are allowed
      to do so on behalf of your organization.
    </p>
    <h2>Your responsibilities</h2>
    <ul>
      <li>Keep your password and two-factor codes private.</li>
      <li>
        Only add people and data you are entitled to process, and tell your team how the workspace is used.
      </li>
      <li>Don't use the service to break the law or to harm others.</li>
    </ul>
    <h2>Performance and reports</h2>
    <p>
      Performance indexes and reports are calculated from data entered into the workspace. They are aids for
      conversations, not complete HR evaluations, and shouldn't be the only basis for employment decisions.
    </p>
    <h2>Availability</h2>
    <p>
      We aim for high availability but the service is provided "as is" during early access, without warranties
      of any kind.
    </p>
    <h2>Ending your use</h2>
    <p>Owners can export data and delete their workspace at any time from Settings → Danger zone.</p>
    <h2>Changes</h2>
    <p>
      We'll post updates to these terms on this page and in the <a href="/changelog">changelog</a>.
    </p>
  </Prose>
</MarketingLayout>
