---
interface Props {
  class?: string;
  withText?: boolean;
}
const { class: cls = "", withText = true } = Astro.props;
---

<span class:list={["inline-flex items-center gap-2.5", cls]}>
  <svg viewBox="0 0 32 32" class="size-8 shrink-0" aria-hidden="true">
    <rect width="32" height="32" rx="9" fill="var(--primary)"></rect>
    <path d="M10 8.5v15h12" fill="none" stroke="var(--primary-fg)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
    <path d="M15 13.5h7M15 18.5h5" fill="none" stroke="var(--primary-fg)" stroke-width="2.6" stroke-linecap="round" opacity=".75"></path>
  </svg>
  {withText && <span class="text-base font-semibold tracking-tight text-text">Office Ledger</span>}
</span>
