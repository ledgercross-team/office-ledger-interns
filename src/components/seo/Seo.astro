---
/**
 * Central SEO tags. App and auth pages pass `noindex`; marketing pages pass JSON-LD via `jsonLd`.
 */
interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  type?: "website" | "article";
}
const {
  title,
  description = "Office Ledger is the workspace for attendance, leave, tasks, calendar, complaints, performance and end-of-day reporting for small and mid-sized offices.",
  image = "/og-default.png",
  noindex = false,
  jsonLd = [],
  type = "website",
} = Astro.props;
const fullTitle = title ? `${title} · Office Ledger` : "Office Ledger · Attendance, leave and tasks for growing offices";
const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, site).toString();
const ogImage = new URL(image, site).toString();
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
<meta property="og:type" content={type} />
<meta property="og:site_name" content="Office Ledger" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#f9fafc" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#12141c" />
{jsonLd.map((data) => <script type="application/ld+json" is:inline set:html={JSON.stringify(data).replace(/</g, "\\u003c")} />)}
