---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  updated?: string;
}
const { eyebrow, title, lead, updated } = Astro.props;
---

<section class="hero-surface border-b border-border">
  <div class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
    {eyebrow && <p class="eyebrow !text-primary">{eyebrow}</p>}
    <h1 class="mt-2 text-4xl font-semibold tracking-tight">{title}</h1>
    {lead && <p class="mt-3 text-lg text-muted">{lead}</p>}
    {updated && <p class="mt-3 text-sm text-muted">Last updated {updated}</p>}
  </div>
</section>
<article class="mx-auto max-w-3xl px-4 py-12 sm:px-6 [&_a]:text-primary [&_a]:underline [&_h2]:mb-3 [&_h2]:mt-10 [&_h2]:text-xl [&_h2]:font-semibold [&_li]:mb-1.5 [&_p]:mb-4 [&_p]:leading-relaxed [&_p]:text-muted [&_ul]:mb-4 [&_ul]:list-disc [&_ul]:ps-5 [&_ul]:text-muted">
  <slot />
</article>
