---
interface Props {
  dark?: boolean;
  withByline?: boolean;
}

const { dark = true, withByline = false } = Astro.props;
---

<span class:list={["marketing-brand", dark && "marketing-brand-dark"]}>
  <span class="marketing-brand-mark" aria-hidden="true">
    <svg viewBox="0 0 32 32" fill="none">
      <circle cx="16" cy="16" r="12.5" stroke="currentColor" stroke-width="2.7"></circle>
      <path
        d="M16 8.5v8l5.5 3.2"
        stroke="currentColor"
        stroke-width="2.7"
        stroke-linecap="round"
        stroke-linejoin="round"
      ></path>
    </svg>
  </span>
  <span class="marketing-brand-name">Office Ledger</span>
  {withByline && <span class="marketing-brand-by">by</span>}
  {withByline && (
    <span class="marketing-brand-cube" aria-label="Ledgercross">
      <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <path d="m16 3 12 7v12l-12 7-12-7V10l12-7Z" stroke="currentColor" stroke-width="1.4"></path>
        <path
          d="m16 3 12 7-12 7-12-7 12-7Zm0 14v12M10 7v12l6 3.5 6-3.5V7"
          stroke="currentColor"
          stroke-width="1.2"
        ></path>
      </svg>
    </span>
  )}
</span>
