# Production runtime template for the Office Ledger API and frontend.
# Replace placeholders with secret values in the hosting provider; do not commit a real .env.

NODE_ENV=production
PORT=4000
DATABASE_URL=postgres://hrms_api:<app-password>@<database-host>:5432/office_ledger_hrms

FRONTEND_URL=https://office-ledger-interns.vercel.app
COOKIE_SECURE=true
# Keep empty when the frontend proxies /api through Next.js.
COOKIE_DOMAIN=
TRUST_PROXY=true

JWT_ACCESS_SECRET=<unique-production-secret-at-least-32-characters>
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
MFA_ENCRYPTION_KEY=<64-hex-character-production-key>

RATE_LIMIT_GLOBAL_PER_MIN=100
RATE_LIMIT_GLOBAL_BLOCK_SECONDS=60
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_AUTH_BLOCK_SECONDS=300

HRMS_JOBS_ENABLED=true
# The current code has no real email provider. Do not treat MAIL_TRANSPORT=log as delivery.
MAIL_TRANSPORT=log

# Frontend build variables for the Vercel same-origin API proxy.
NEXT_PUBLIC_API_URL=/api
API_ORIGIN=https://intern.tuiber.com

# Do not place these in the API runtime environment:
# SEED_DEMO_PASSWORD
# HRMS_MIGRATE_DATABASE_URL
