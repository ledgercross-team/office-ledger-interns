  "narrative": {
    "northStar": "The Guide Map",
    "overview": "LedgerCross reads like a printed visitor's map: flat regions of colour do the dividing, and capsules do the acting.",
    "keyCharacteristics": [
      "Flat unmodulated colour; depth comes from tonal surface steps, not shadows.",
      "One green rail owns navigation; one clay capsule per area owns the primary action.",
      "Rounded forms throughout: capsules for actions and state, large radii for containers.",
      "Tabular figures everywhere numbers are compared."
    ],
    "rules": [
      {
        "name": "The One Region Rule",
        "body": "Sage Rail is the navigation rail and nothing else; it never fills content.",
        "section": "colors"
      },
      {
        "name": "The One Action Rule",
        "body": "Clay marks something that can be done; it is never decoration or a state.",
        "section": "colors"
      },
      {
        "name": "The Tabular Rule",
        "body": "Numbers use tabular figures globally so columns align.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do keep one clay capsule per work area for the primary action.",
      "Do carry state in a label or shape as well as colour.",
      "Do use tabular figures for all comparable numbers."
    ],
    "donts": [
      "Don't use gradients, blur or glass on surfaces.",
      "Don't fill content regions with Sage Rail or use clay as decoration.",
      "Don't build dark-mode variants without revisiting contrast on the rail and clay."
    ]
