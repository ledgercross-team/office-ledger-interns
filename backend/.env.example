NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://office_ledger_app:change_me_locally@localhost:5432/office_ledger_dev
REDIS_URL=redis://localhost:6379/0
FRONTEND_URL=http://localhost:3000

JWT_ACCESS_SECRET=replace-with-output-of-openssl-rand-base64-48

JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

COOKIE_SECURE=false
COOKIE_DOMAIN=
TRUST_PROXY=false

RATE_LIMIT_GLOBAL_PER_MIN=100
RATE_LIMIT_GLOBAL_BLOCK_SECONDS=60
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_AUTH_BLOCK_SECONDS=300
SEED_DEMO_PASSWORD=change-me-demo-password

# HRMS routes (docs/hrms/RUNBOOK.md). false: no HRMS routes exist.
HRMS_V2_ENABLED=false
# Login of the HRMS database, as the hrms_api role (never the owner). Needed when the flag is true.
HRMS_DATABASE_URL=postgres://hrms_api:change_me_locally@localhost:5432/office_ledger_hrms
# Encrypts MFA secrets: 32 random bytes as 64 hex characters (openssl rand -hex 32). Required with the flag.
MFA_ENCRYPTION_KEY=
# The scheduler inside the API (expiry, reminders, auto check-out, scores, email). Default true.
HRMS_JOBS_ENABLED=true
# How emails leave the API: log (written to the application log) or none.
MAIL_TRANSPORT=log
# Owner login of the new database. Only the migrate and seed scripts read it; the API never does.
HRMS_MIGRATE_DATABASE_URL=postgres://postgres@localhost:5432/office_ledger_hrms
