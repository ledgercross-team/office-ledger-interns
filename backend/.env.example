NODE_ENV=development
PORT=4000
# Login of the office_ledger_hrms database, as the hrms_api role (never the owner).
DATABASE_URL=postgres://hrms_api:change_me_locally@localhost:5432/office_ledger_hrms
REDIS_URL=redis://localhost:6379/0
FRONTEND_URL=http://localhost:3000

JWT_ACCESS_SECRET=replace-with-output-of-openssl-rand-base64-48

JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

COOKIE_SECURE=false
COOKIE_DOMAIN=
TRUST_PROXY=false

RATE_LIMIT_GLOBAL_PER_MIN=100
RATE_LIMIT_GLOBAL_BLOCK_SECONDS=60
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_AUTH_BLOCK_SECONDS=300
SEED_DEMO_PASSWORD=change-me-demo-password

# Set to false to sign gameMaster, CEO and COO in with email and password only.
MFA_REQUIRED=true
# Encrypts MFA secrets: 32 random bytes as 64 hex characters (openssl rand -hex 32). Required.
MFA_ENCRYPTION_KEY=
# The scheduler inside the API (expiry, reminders, auto check-out, scores, email). Default true.
HRMS_JOBS_ENABLED=true
# How emails leave the API: log (written to the application log) or none.
MAIL_TRANSPORT=log
# Owner login of the database. Only the migrate, seed and create-game-master scripts read it; the API never does.
HRMS_MIGRATE_DATABASE_URL=postgres://postgres@localhost:5432/office_ledger_hrms
