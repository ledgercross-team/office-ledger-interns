{
  "name": "office-ledger",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node server.mjs",
    "preview": "node server.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "astro check && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/reset.ts && pnpm db:migrate && pnpm db:seed",
    "db:local": "tsx scripts/local-postgres.ts",
    "icons": "tsx scripts/generate-icons.ts",
    "prepare": "husky || true",
    "db:migrate:prod": "node scripts/migrate.mjs",
    "screenshots": "tsx scripts/capture-screenshots.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{astro,css,md,json,yml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@node-rs/argon2",
      "embedded-postgres",
      "@embedded-postgres/linux-x64",
      "@tailwindcss/oxide",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@astrojs/node": "11.1.6",
    "@astrojs/react": "7.0.0",
    "@astrojs/sitemap": "^3.7.4",
    "@date-fns/tz": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@node-rs/argon2": "^2.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-table": "^8.21.3",
    "astro": "7.3.5",
    "better-auth": "~1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dompurify": "^3.4.16",
    "dotenv": "^18.0.5",
    "drizzle-orm": "~0.45.3",
    "fflate": "^0.8.3",
    "jsdom": "^30.1.2",
    "lucide-react": "^1.52.0",
    "marked": "^18.0.14",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.14",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "sirv": "^3.0.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/dompurify": "^3.2.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "~0.31.11",
    "embedded-postgres": "16.14.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
